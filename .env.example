# Copy this file to .env and adjust the values for your machine:
#   macOS/Linux : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
#
# .env is ignored by Git. NEVER commit real credentials; this file holds
# placeholders only. `python -m src.cli validate-env` checks every value below.

# Host-side commands (python -m src.cli ...) reach PostgreSQL on localhost.
# Docker Compose overrides POSTGRES_HOST to the service name "postgres"
# for the containers, so you do not need to change it for Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p

# Placeholder. Pick your own password for anything beyond a local lab.
# validate-env warns while this is still the placeholder value.
POSTGRES_PASSWORD=change_me
